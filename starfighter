      bossPhaseTag.textContent = `P${boss.phase}`;
      bossHpPercent.textContent = `${Math.max(0, Math.ceil(boss.hp)).toLocaleString()}/${boss.maxHp.toLocaleString()}`;
      bossHpFill.style.width = `${Math.max(0, (boss.hp / boss.maxHp) * 100)}%`;
    } else {
      bossHud.style.display = 'none';
    }
  }

  // 무기 레벨(1~300)에 따른 발사 로직
  function firePlayerWeapons() {
    const lv = player.weaponLevel;
    const cooldown = Math.max(0.055, 0.17 - lv * 0.00042);
    player.fireTimer = cooldown;
    sfx.shoot(lv);

    const baseDmg = 18 + lv * 7.5 + Math.pow(lv, 1.32) * 0.65;
    const streams = Math.min(11, 1 + Math.floor(lv / 28) * 2);
    const spreadStep = 0.065;
    const startAngle = -Math.PI / 2 - ((streams - 1) * spreadStep) / 2;

    let bulletColor = '#00f5ff';
    if (lv >= 250) bulletColor = '#ffd000';
    else if (lv >= 180) bulletColor = '#ff2a85';
    else if (lv >= 100) bulletColor = '#c084fc';
    else if (lv >= 40) bulletColor = '#38bdf8';

    for (let i = 0; i < streams; i++) {
      const ang = startAngle + i * spreadStep;
      const spd = 760 + Math.min(260, lv * 0.8);
      bullets.push({
        x: player.x + (i - (streams - 1) / 2) * 4,
        y: player.y - 16,
        vx: Math.cos(ang) * spd,
        vy: Math.sin(ang) * spd,
        dmg: baseDmg / (1 + (streams - 1) * 0.28),
        r: lv >= 150 ? 4.5 : 3.4,
        color: bulletColor,
        pierce: lv >= 200 ? 1 : 0
      });
    }

    if (lv >= 20) {
      const podDmg = baseDmg * 0.45;
      [-22, 22].forEach((offsetX) => {
        bullets.push({
          x: player.x + offsetX,
          y: player.y - 6,
          vx: 0,
          vy: -880,
          dmg: podDmg,
          r: 3.2,
          color: '#22ff88',
          pierce: 0
        });
      });
    }
  }

  function spawnEnemy() {
    if (boss) return;
    const roll = Math.random();
    let type = 'SCOUT';
    if (wave >= 3 && roll > 0.72) type = 'CRUISER';
    else if (roll > 0.38) type = 'INTERCEPTOR';

    const scale = 1 + (wave - 1) * 0.45 + Math.pow(wave, 1.35) * 0.12;
    let hp = 45 * scale;
    let r = 15;
    let speed = 135 + Math.min(140, wave * 4);
    let color = '#38bdf8';
    let pts = 120 * wave;

    if (type === 'INTERCEPTOR') {
      hp = 85 * scale;
      r = 18;
      speed = 165 + Math.min(150, wave * 4.5);
      color = '#c084fc';
      pts = 240 * wave;
    } else if (type === 'CRUISER') {
      hp = 220 * scale;
      r = 25;
      speed = 85 + Math.min(70, wave * 2.5);
      color = '#ff7b00';
      pts = 500 * wave;
    }

    enemies.push({
      type,
      x: Math.random() * (W - 60) + 30,
      y: -35,
      vx: (Math.random() - 0.5) * 70,
      vy: speed,
      hp,
      maxHp: hp,
      r,
      color,
      pts,
      shootTimer: Math.random() * 1.4 + 0.6
    });
  }

  // 보스 생성 (최대 체력 300만 제한 적용)
  function spawnBoss() {
    const bossNames = [
      'MK-I INTERCEPTOR',
      'CRIMSON DREADNOUGHT',
      'VOID LEVIATHAN',
      'OMEGA OVERLORD',
      'HYPERION CORE'
    ];
    const name = bossNames[(wave - 1) % bossNames.length];

    const rawHp = Math.round(10800 * Math.pow(1.62, wave - 1));
    const maxHp = Math.min(MAX_BOSS_HP_CAP, rawHp);

    boss = {
      name,
      x: W / 2,
      y: -90,
      targetY: Math.min(155, H * 0.22),
      vx: 95 + Math.min(110, wave * 6),
      r: 46,
      hp: maxHp,
      maxHp,
      phase: 1,
      fireTimer: 1.0,
      patternAngle: 0
    };

    warningBanner.style.display = 'flex';
    sfx.warning();
    setTimeout(() => {
      warningBanner.style.display = 'none';
    }, 2200);
    updateHUD();
  }

  function dropPowerup(x, y, forceWeapon = false) {
    const roll = Math.random();
    let type = 'WEAPON';
    if (!forceWeapon) {
      if (roll < 0.72) type = 'WEAPON';
      else if (roll < 0.90) type = 'HEAL';
      else type = 'SHIELD';
    }
    powerups.push({
      x, y,
      vy: 115,
      r: 13,
      type
    });
  }

  function updateBossAttacks(dt) {
    if (!boss) return;

    const hpRatio = boss.hp / boss.maxHp;
    if (hpRatio <= 0.33) boss.phase = 3;
    else if (hpRatio <= 0.66) boss.phase = 2;
    else boss.phase = 1;

    boss.fireTimer -= dt;
    if (boss.fireTimer > 0) return;

    const bulletSpeed = 230 + Math.min(180, wave * 8);

    if (boss.phase === 1) {
      boss.fireTimer = 0.85;
      const count = 7;
      const baseAng = Math.atan2(player.y - boss.y, player.x - boss.x);
      for (let i = 0; i < count; i++) {
        const ang = baseAng + (i - (count - 1) / 2) * 0.16;
        enemyBullets.push({
          x: boss.x,
          y: boss.y + 26,
          vx: Math.cos(ang) * bulletSpeed,
          vy: Math.sin(ang) * bulletSpeed,
          r: 5,
          color: '#ff2a85'
        });
      }
    } else if (boss.phase === 2) {
      boss.fireTimer = 0.24;
      boss.patternAngle += 0.34;
      for (let k = 0; k < 4; k++) {
        const ang = boss.patternAngle + (k * Math.PI) / 2;
        enemyBullets.push({
          x: boss.x,
          y: boss.y + 10,
          vx: Math.cos(ang) * (bulletSpeed * 0.92),
          vy: Math.sin(ang) * (bulletSpeed * 0.92),
          r: 4.8,
          color: '#ff7b00'
        });
      }
    } else {
      boss.fireTimer = 0.45;
      boss.patternAngle += 0.22;
      const ringCount = 12;
      for (let i = 0; i < ringCount; i++) {
        const ang = boss.patternAngle + (i * Math.PI * 2) / ringCount;
        enemyBullets.push({
          x: boss.x,
          y: boss.y + 10,
          vx: Math.cos(ang) * bulletSpeed,
          vy: Math.sin(ang) * bulletSpeed,
          r: 5.2,
          color: '#ffd000'
        });
      }
    }
  }

  function damagePlayer(amount) {
    if (player.invulnTimer > 0) return;
    if (player.shieldTimer > 0) {
      player.shieldTimer = 0;
      player.invulnTimer = 0.8;
      spawnFloatingText(player.x, player.y - 22, 'SHIELD BLOCK!', '#00f5ff', 13);
      return;
    }

    player.hp -= amount;
    player.invulnTimer = 0.75;
    screenShake = 10;
    sfx.explosion(false);
    spawnExplosion(player.x, player.y, '#ff2a85', 14, 0.9);

    if (player.hp <= 0) {
      player.hp = 0;
      updateHUD();
      triggerGameOver();
    }
  }

  function triggerGameOver() {
    state = 'GAMEOVER';
    sfx.explosion(true);
    finalScoreEl.textContent = Math.floor(score).toLocaleString();
    finalWaveEl.textContent = `W-${String(wave).padStart(2, '0')}`;
    finalWpnEl.textContent = `LV.${player.weaponLevel}`;
    gameOverOverlay.classList.remove('hidden');
    renderLeaderboard();
  }

  function resetGame() {
    sfx.init();
    resizeCanvas();
    score = 0;
    wave = 1;
    waveKills = 0;
    waveQuota = 10;
    screenShake = 0;

    player.x = W / 2;
    player.y = H * 0.8;
    player.targetX = W / 2;
    player.targetY = H * 0.8;
    player.hp = 100;
    player.maxHp = 100;
    player.weaponLevel = 1;
    player.fireTimer = 0;
    player.invulnTimer = 1.0;
    player.shieldTimer = 0;

    bullets = [];
    enemyBullets = [];
    enemies = [];
    powerups = [];
    particles = [];
    floatingTexts = [];
    boss = null;
    enemySpawnTimer = 0.4;

    startOverlay.classList.add('hidden');
    gameOverOverlay.classList.add('hidden');
    warningBanner.style.display = 'none';
    state = 'PLAYING';
    updateHUD();
  }

  startBtn.addEventListener('click', resetGame);
  restartBtn.addEventListener('click', resetGame);

  function update(dt) {
    for (const s of stars) {
      s.y += s.speed * dt;
      if (s.y > H) {
        s.y = -4;
        s.x = Math.random() * W;
      }
    }

    if (screenShake > 0) {
      screenShake = Math.max(0, screenShake - dt * 28);
    }

    if (state !== 'PLAYING') return;

    const keySpeed = 420;
    if (keys['ArrowLeft'] || keys['KeyA']) player.targetX -= keySpeed * dt;
    if (keys['ArrowRight'] || keys['KeyD']) player.targetX += keySpeed * dt;
    if (keys['ArrowUp'] || keys['KeyW']) player.targetY -= keySpeed * dt;
    if (keys['ArrowDown'] || keys['KeyS']) player.targetY += keySpeed * dt;

    player.targetX = Math.max(20, Math.min(W - 20, player.targetX));
    player.targetY = Math.max(70, Math.min(H - 24, player.targetY));

    player.x += (player.targetX - player.x) * Math.min(1, dt * 22);
    player.y += (player.targetY - player.y) * Math.min(1, dt * 22);

    if (player.invulnTimer > 0) player.invulnTimer -= dt;
    if (player.shieldTimer > 0) player.shieldTimer -= dt;

    player.fireTimer -= dt;
    if (player.fireTimer <= 0) {
      firePlayerWeapons();
    }

    for (let i = bullets.length - 1; i >= 0; i--) {
      const b = bullets[i];
      b.x += b.vx * dt;
      b.y += b.vy * dt;
      if (b.y < -30 || b.x < -30 || b.x > W + 30) {
        bullets.splice(i, 1);
      }
    }

    if (!boss) {
      enemySpawnTimer -= dt;
      if (enemySpawnTimer <= 0) {
        spawnEnemy();
        enemySpawnTimer = Math.max(0.32, 1.05 - wave * 0.045);
      }
    } else {
      if (boss.y < boss.targetY) {
        boss.y += 95 * dt;
      } else {
        boss.x += boss.vx * dt;
        if (boss.x < 62) {
          boss.x = 62;
          boss.vx = Math.abs(boss.vx);
        } else if (boss.x > W - 62) {
          boss.x = W - 62;
          boss.vx = -Math.abs(boss.vx);
        }
        updateBossAttacks(dt);
      }
    }

    for (let i = enemies.length - 1; i >= 0; i--) {
      const e = enemies[i];
      e.x += e.vx * dt;
      e.y += e.vy * dt;
      if (e.x < e.r + 8 || e.x > W - e.r - 8) e.vx *= -1;

      e.shootTimer -= dt;
      if (e.shootTimer <= 0 && e.y > 40 && e.y < H * 0.65) {
        e.shootTimer = Math.max(0.85, 2.1 - wave * 0.05);
        const ang = Math.atan2(player.y - e.y, player.x - e.x);
        const spd = 210 + Math.min(160, wave * 6);
        enemyBullets.push({
          x: e.x,
          y: e.y + e.r,
          vx: Math.cos(ang) * spd,
          vy: Math.sin(ang) * spd,
          r: 4.2,
          color: '#ff2a85'
        });
      }

      let destroyed = false;
      for (let j = bullets.length - 1; j >= 0; j--) {
        const b = bullets[j];
        const dx = b.x - e.x;
        const dy = b.y - e.y;
        if (dx * dx + dy * dy <= (b.r + e.r) * (b.r + e.r)) {
          e.hp -= b.dmg;
          sfx.hit();
          if (b.pierce > 0) b.pierce--;
          else bullets.splice(j, 1);

          if (e.hp <= 0) {
            destroyed = true;
            score += e.pts;
            waveKills++;
            sfx.explosion(false);
            spawnExplosion(e.x, e.y, e.color, 14, 0.9);

            if (Math.random() < 0.34) {
              dropPowerup(e.x, e.y, false);
            }

            if (!boss && waveKills >= waveQuota) {
              spawnBoss();
            }
            break;
          }
        }
      }

      if (destroyed) {
        enemies.splice(i, 1);
        continue;
      }

      const pdx = player.x - e.x;
      const pdy = player.y - e.y;
      if (pdx * pdx + pdy * pdy <= (player.radius + e.r - 4) * (player.radius + e.r - 4)) {
        damagePlayer(24);
        spawnExplosion(e.x, e.y, e.color, 12, 0.8);
        enemies.splice(i, 1);
        continue;
      }

      if (e.y > H + 50) {
        enemies.splice(i, 1);
      }
    }

    if (boss) {
      for (let j = bullets.length - 1; j >= 0; j--) {
        const b = bullets[j];
        const dx = b.x - boss.x;
        const dy = b.y - boss.y;
        if (dx * dx + dy * dy <= (b.r + boss.r) * (b.r + boss.r)) {
          boss.hp -= b.dmg;
          sfx.hit();
          bullets.splice(j, 1);

          if (boss.hp <= 0) {
            const defeatedBoss = boss;
            boss = null;
            score += 5000 * wave;
            screenShake = 18;
            sfx.explosion(true);
            spawnExplosion(defeatedBoss.x, defeatedBoss.y, '#ffd000', 42, 1.5);
            spawnFloatingText(defeatedBoss.x, defeatedBoss.y, 'BOSS DESTROYED!', '#ffd000', 16);

            dropPowerup(defeatedBoss.x - 28, defeatedBoss.y, true);
            dropPowerup(defeatedBoss.x, defeatedBoss.y + 10, true);
            dropPowerup(defeatedBoss.x + 28, defeatedBoss.y, true);

            wave++;
            waveKills = 0;
            waveQuota = 10 + wave * 3;
            player.hp = Math.min(player.maxHp, player.hp + 30);
            break;
          }
        }
      }
    }

    for (let i = enemyBullets.length - 1; i >= 0; i--) {
      const eb = enemyBullets[i];
      eb.x += eb.vx * dt;
      eb.y += eb.vy * dt;

      const dx = eb.x - player.x;
      const dy = eb.y - player.y;
      if (dx * dx + dy * dy <= (eb.r + player.radius - 4) * (eb.r + player.radius - 4)) {
        enemyBullets.splice(i, 1);
        damagePlayer(15);
        continue;
      }

      if (eb.y < -30 || eb.y > H + 30 || eb.x < -30 || eb.x > W + 30) {
        enemyBullets.splice(i, 1);
      }
    }

    for (let i = powerups.length - 1; i >= 0; i--) {
      const p = powerups[i];
      p.y += p.vy * dt;

      const dx = player.x - p.x;
      const dy = player.y - p.y;
      const dist = Math.hypot(dx, dy);
      if (dist < 110) {
        p.x += (dx / dist) * 240 * dt;
        p.y += (dy / dist) * 240 * dt;
      }

      if (dist <= player.radius + p.r + 6) {
        sfx.powerup();
        if (p.type === 'WEAPON') {
          if (player.weaponLevel < MAX_WEAPON_LEVEL) {
            const gain = Math.min(MAX_WEAPON_LEVEL - player.weaponLevel, 1 + Math.floor(wave / 3));
            player.weaponLevel += gain;
            spawnFloatingText(player.x, player.y - 24, `WEAPON LV.${player.weaponLevel}!`, '#00f5ff', 13);
          } else {
            score += 1500;
            spawnFloatingText(player.x, player.y - 24, 'MAX LV.300 BONUS +1500', '#ffd000', 12);
          }
        } else if (p.type === 'HEAL') {
          player.hp = Math.min(player.maxHp, player.hp + 35);
          spawnFloatingText(player.x, player.y - 24, 'REPAIR +35%', '#22ff88', 13);
        } else if (p.type === 'SHIELD') {
          player.shieldTimer = 8.0;
          spawnFloatingText(player.x, player.y - 24, 'ENERGY SHIELD!', '#c084fc', 13);
        }
        powerups.splice(i, 1);
        continue;
      }

      if (p.y > H + 30) {
        powerups.splice(i, 1);
      }
    }

    for (let i = particles.length - 1; i >= 0; i--) {
      const pt = particles[i];
      pt.x += pt.vx * dt;
      pt.y += pt.vy * dt;
      pt.life -= dt;
      if (pt.life <= 0) particles.splice(i, 1);
    }

    for (let i = floatingTexts.length - 1; i >= 0; i--) {
      const ft = floatingTexts[i];
      ft.y += ft.vy * dt;
      ft.life -= dt;
      if (ft.life <= 0) floatingTexts.splice(i, 1);
    }

    updateHUD();
  }

  function draw() {
    ctx.save();
    ctx.fillStyle = '#050712';
    ctx.fillRect(0, 0, W, H);

    if (screenShake > 0) {
      const sx = (Math.random() - 0.5) * screenShake;
      const sy = (Math.random() - 0.5) * screenShake;
      ctx.translate(sx, sy);
    }

    for (const s of stars) {
      ctx.fillStyle = `rgba(180, 230, 255, ${s.alpha})`;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
    }

    for (const p of powerups) {
      let col = '#00f5ff';
      let label = 'P';
      if (p.type === 'HEAL') { col = '#22ff88'; label = '+'; }
      else if (p.type === 'SHIELD') { col = '#c084fc'; label = 'S'; }

      ctx.save();
      ctx.shadowBlur = 12;
      ctx.shadowColor = col;
      ctx.strokeStyle = col;
      ctx.lineWidth = 2;
      ctx.fillStyle = 'rgba(8, 13, 30, 0.85)';
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = '#ffffff';
      ctx.font = '900 11px sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(label, p.x, p.y + 0.5);
      ctx.restore();
    }

    for (const b of bullets) {
      ctx.save();
      ctx.shadowBlur = 10;
      ctx.shadowColor = b.color;
      ctx.fillStyle = b.color;
      ctx.beginPath();
      ctx.roundRect(b.x - b.r * 0.65, b.y - b.r * 2.2, b.r * 1.3, b.r * 4.4, 3);
      ctx.fill();
      ctx.restore();
    }

    for (const eb of enemyBullets) {
      ctx.save();
      ctx.shadowBlur = 10;
      ctx.shadowColor = eb.color;
      ctx.fillStyle = eb.color;
      ctx.beginPath();
      ctx.arc(eb.x, eb.y, eb.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(eb.x, eb.y, eb.r * 0.42, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    for (const e of enemies) {
      ctx.save();
      ctx.translate(e.x, e.y);
      ctx.shadowBlur = 12;
      ctx.shadowColor = e.color;
      ctx.strokeStyle = e.color;
      ctx.fillStyle = 'rgba(12, 18, 40, 0.9)';
      ctx.lineWidth = 2;

      ctx.beginPath();
      ctx.moveTo(0, e.r);
      ctx.lineTo(e.r * 0.95, -e.r * 0.75);
      ctx.lineTo(0, -e.r * 0.35);
      ctx.lineTo(-e.r * 0.95, -e.r * 0.75);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      if (e.hp < e.maxHp) {
        const bw = e.r * 1.8;
        ctx.fillStyle = 'rgba(255,255,255,0.18)';
        ctx.fillRect(-bw / 2, -e.r - 9, bw, 3);
        ctx.fillStyle = e.color;
        ctx.fillRect(-bw / 2, -e.r - 9, bw * Math.max(0, e.hp / e.maxHp), 3);
      }
      ctx.restore();
    }

    if (boss) {
      ctx.save();
      ctx.translate(boss.x, boss.y);
      const bossCol = boss.phase === 3 ? '#ffd000' : (boss.phase === 2 ? '#ff7b00' : '#ff2a85');
      ctx.shadowBlur = 22;
      ctx.shadowColor = bossCol;
      ctx.strokeStyle = bossCol;
      ctx.fillStyle = 'rgba(24, 8, 22, 0.92)';
      ctx.lineWidth = 2.6;

      ctx.beginPath();
      ctx.moveTo(0, boss.r);
      ctx.lineTo(boss.r * 1.15, boss.r * 0.15);
      ctx.lineTo(boss.r * 0.85, -boss.r * 0.85);
      ctx.lineTo(-boss.r * 0.85, -boss.r * 0.85);
      ctx.lineTo(-boss.r * 1.15, boss.r * 0.15);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = bossCol;
      ctx.beginPath();
      ctx.arc(0, 0, boss.r * 0.32, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    if (state === 'PLAYING') {
      const blink = player.invulnTimer > 0 && Math.floor(player.invulnTimer * 18) % 2 === 0;
      if (!blink) {
        ctx.save();
        ctx.translate(player.x, player.y);

        const flameLen = 14 + Math.random() * 10;
        ctx.fillStyle = '#00f5ff';
        ctx.beginPath();
        ctx.moveTo(-6, 12);
        ctx.lineTo(0, 12 + flameLen);
        ctx.lineTo(6, 12);
        ctx.closePath();
        ctx.fill();

        ctx.shadowBlur = 15;
        ctx.shadowColor = '#00f5ff';
        ctx.strokeStyle = '#00f5ff';
        ctx.fillStyle = '#0b1736';
        ctx.lineWidth = 2.2;

        ctx.beginPath();
        ctx.moveTo(0, -20);
        ctx.lineTo(17, 14);
        ctx.lineTo(0, 7);
        ctx.lineTo(-17, 14);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.ellipse(0, -3, 3.2, 7, 0, 0, Math.PI * 2);
        ctx.fill();

        if (player.shieldTimer > 0) {
          ctx.strokeStyle = '#c084fc';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(0, 0, 26, 0, Math.PI * 2);
          ctx.stroke();
        }
        ctx.restore();
      }
    }

    for (const pt of particles) {
      ctx.save();
      ctx.globalAlpha = Math.max(0, pt.life / pt.maxLife);
      ctx.fillStyle = pt.color;
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, pt.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    for (const ft of floatingTexts) {
      ctx.save();
      ctx.globalAlpha = Math.max(0, ft.life / ft.maxLife);
      ctx.fillStyle = ft.color;
      ctx.font = `900 ${ft.size}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.fillText(ft.text, ft.x, ft.y);
      ctx.restore();
    }

    ctx.restore();
  }

  function gameLoop(timestamp) {
    if (!lastTime) lastTime = timestamp;
    const dt = Math.min(0.05, (timestamp - lastTime) / 1000);
    lastTime = timestamp;

    update(dt);
    draw();
    requestAnimationFrame(gameLoop);
  }

  requestAnimationFrame(gameLoop);
})();
</script>
</body>
