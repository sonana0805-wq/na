              <div id="finalWpn" class="text-sm sm:text-base font-black text-amber-400 mt-0.5">LV.1</div>
            </div>
          </div>

          <button id="restartBtn" class="cta-btn">RETRY MISSION</button>
        </div>
      </div>
    </section>

    <!-- 2. 게임 특징 및 시스템 가이드 섹션 -->
