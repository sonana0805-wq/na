      </tr>
    `).join('');
  }
  renderLeaderboard();

  let wave = 1;
  let waveKills = 0;
  let waveQuota = 10;
  let screenShake = 0;
  let lastTime = 0;

  // 배경 별빛 파티클
  const stars = Array.from({ length: 80 }, () => ({
    x: Math.random() * W,
    y: Math.random() * H,
    r: Math.random() * 1.7 + 0.4,
    speed: Math.random() * 95 + 30,
    alpha: Math.random() * 0.7 + 0.25
  }));

  // 플레이어 상태
  const player = {
    x: W / 2,
    y: H * 0.8,
    targetX: W / 2,
    targetY: H * 0.8,
    radius: 15,
    hp: 100,
    maxHp: 100,
    weaponLevel: 1,
    fireTimer: 0,
    invulnTimer: 0,
    shieldTimer: 0
  };

  let bullets = [];
  let enemyBullets = [];
  let enemies = [];
  let powerups = [];
  let particles = [];
  let floatingTexts = [];
  let boss = null;
  let enemySpawnTimer = 0;

  // 입력 컨트롤 (드래그 + 키보드)
  const keys = {};
  let isPointerDown = false;
  let lastPointerX = 0;
  let lastPointerY = 0;

  window.addEventListener('keydown', (e) => {
    keys[e.code] = true;
    if (state === 'PLAYING' && ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Space'].includes(e.code)) {
      e.preventDefault();
    }
  });
  window.addEventListener('keyup', (e) => {
    keys[e.code] = false;
  });

  canvas.addEventListener('pointerdown', (e) => {
    if (state !== 'PLAYING') return;
    sfx.init();
    isPointerDown = true;
    lastPointerX = e.clientX;
    lastPointerY = e.clientY;
  });

  window.addEventListener('pointermove', (e) => {
    if (!isPointerDown || state !== 'PLAYING') return;
    const dx = e.clientX - lastPointerX;
    const dy = e.clientY - lastPointerY;
    lastPointerX = e.clientX;
    lastPointerY = e.clientY;
    player.targetX = Math.max(20, Math.min(W - 20, player.targetX + dx));
    player.targetY = Math.max(70, Math.min(H - 24, player.targetY + dy));
  });

  window.addEventListener('pointerup', () => { isPointerDown = false; });
  window.addEventListener('pointercancel', () => { isPointerDown = false; });

  function spawnFloatingText(x, y, text, color = '#00f5ff', size = 12) {
    floatingTexts.push({
      x, y, text, color, size,
      vy: -42,
      life: 0.85,
      maxLife: 0.85
    });
  }

  function spawnExplosion(x, y, color, count = 16, speedScale = 1) {
    for (let i = 0; i < count; i++) {
      const ang = Math.random() * Math.PI * 2;
      const spd = (Math.random() * 140 + 40) * speedScale;
      particles.push({
        x, y,
        vx: Math.cos(ang) * spd,
        vy: Math.sin(ang) * spd,
        r: Math.random() * 2.8 + 1.2,
        color,
        life: Math.random() * 0.4 + 0.25,
        maxLife: 0.65
      });
    }
  }

  function updateHUD() {
    scoreVal.textContent = Math.floor(score).toLocaleString();
    if (score > bestScore) {
      bestScore = Math.floor(score);
      bestWave = Math.max(bestWave, wave);
      bestWpn = Math.max(bestWpn, player.weaponLevel);
      localStorage.setItem('neon_starfighter_best', String(bestScore));
      localStorage.setItem('neon_starfighter_best_wave', String(bestWave));
      localStorage.setItem('neon_starfighter_best_wpn', String(bestWpn));
      bestVal.textContent = bestScore.toLocaleString();
    }

    waveVal.textContent = `W-${String(wave).padStart(2, '0')}`;

    const hpPct = Math.max(0, Math.min(100, Math.round((player.hp / player.maxHp) * 100)));
    hpText.textContent = `HP ${hpPct}%`;
    hpFill.style.width = `${hpPct}%`;

    wpnText.textContent = `LV.${player.weaponLevel}/${MAX_WEAPON_LEVEL}`;
    const wpnPct = Math.min(100, (player.weaponLevel / MAX_WEAPON_LEVEL) * 100);
    wpnFill.style.width = `${wpnPct}%`;

    if (boss && boss.hp > 0) {
      bossHud.style.display = 'block';
