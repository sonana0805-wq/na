<script>
(() => {
  // === 게임 핵심 상수 ===
  const MAX_WEAPON_LEVEL = 300;        // 무기 최대 레벨 300
  const MAX_BOSS_HP_CAP = 3000000;     // 보스 최대 체력 상한 300만 (3,000,000)

  const stageContainer = document.getElementById('gameStageContainer');
  const canvas = document.getElementById('gameCanvas');
  const ctx = canvas.getContext('2d');

  // UI 요소 참조
  const scoreVal = document.getElementById('scoreVal');
  const waveVal = document.getElementById('waveVal');
  const bestVal = document.getElementById('bestVal');
  const hpText = document.getElementById('hpText');
  const hpFill = document.getElementById('hpFill');
  const wpnText = document.getElementById('wpnText');
  const wpnFill = document.getElementById('wpnFill');

  const bossHud = document.getElementById('bossHud');
  const bossNameEl = document.getElementById('bossName');
  const bossPhaseTag = document.getElementById('bossPhaseTag');
  const bossHpPercent = document.getElementById('bossHpPercent');
  const bossHpFill = document.getElementById('bossHpFill');
  const warningBanner = document.getElementById('warningBanner');

  const startOverlay = document.getElementById('startOverlay');
  const gameOverOverlay = document.getElementById('gameOverOverlay');
  const finalScoreEl = document.getElementById('finalScore');
  const finalWaveEl = document.getElementById('finalWave');
  const finalWpnEl = document.getElementById('finalWpn');
  const startBtn = document.getElementById('startBtn');
  const restartBtn = document.getElementById('restartBtn');
  const soundBtn = document.getElementById('soundBtn');
  const stageFullscreenBtn = document.getElementById('stageFullscreenBtn');
  const headerFullscreenBtn = document.getElementById('headerFullscreenBtn');
  const myBestBadge = document.getElementById('myBestBadge');
  const leaderboardBody = document.getElementById('leaderboardBody');

  // 웹 오디오 합성 사운드 엔진
  class SoundFX {
    constructor() {
      this.ctx = null;
      this.enabled = true;
    }
    init() {
      if (!this.ctx) {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (AudioCtx) this.ctx = new AudioCtx();
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
    }
    playTone(freq, endFreq, duration, type = 'sine', vol = 0.06) {
      if (!this.enabled || !this.ctx) return;
      try {
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, now);
        osc.frequency.exponentialRampToValueAtTime(Math.max(20, endFreq), now + duration);
        gain.gain.setValueAtTime(vol, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + duration);
      } catch (e) {}
    }
    shoot(lv) {
      const pitch = 520 + Math.min(480, lv * 1.6);
      this.playTone(pitch, 180, 0.055, 'triangle', 0.032);
    }
    hit() {
      this.playTone(190, 75, 0.045, 'square', 0.022);
    }
    explosion(big = false) {
      this.playTone(big ? 140 : 210, 28, big ? 0.45 : 0.2, 'sawtooth', big ? 0.11 : 0.06);
    }
    powerup() {
      this.playTone(440, 880, 0.14, 'sine', 0.07);
      setTimeout(() => this.playTone(660, 1320, 0.16, 'triangle', 0.06), 60);
    }
    warning() {
      this.playTone(320, 190, 0.25, 'sawtooth', 0.08);
    }
  }
  const sfx = new SoundFX();

  soundBtn.addEventListener('click', () => {
    sfx.init();
    sfx.enabled = !sfx.enabled;
    soundBtn.textContent = sfx.enabled ? '🔊' : '🔇';
    soundBtn.style.opacity = sfx.enabled ? '0.9' : '0.45';
  });

  // 전체화면 토글 기능 (네이티브 Fullscreen + CSS 폴백 지원)
  function toggleFullscreen() {
    const isCurrentlyFs = stageContainer.classList.contains('is-fullscreen') || document.fullscreenElement;
    if (!isCurrentlyFs) {
      stageContainer.classList.add('is-fullscreen');
      if (stageContainer.requestFullscreen) {
        stageContainer.requestFullscreen().catch(() => {});
      }
      headerFullscreenBtn.textContent = '✕ 창모드';
      stageFullscreenBtn.textContent = '✕';
    } else {
      stageContainer.classList.remove('is-fullscreen');
      if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen().catch(() => {});
      }
      headerFullscreenBtn.textContent = '⛶ 전체화면';
      stageFullscreenBtn.textContent = '⛶';
    }
    setTimeout(resizeCanvas, 50);
  }

  stageFullscreenBtn.addEventListener('click', toggleFullscreen);
  headerFullscreenBtn.addEventListener('click', toggleFullscreen);
  document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement) {
      stageContainer.classList.remove('is-fullscreen');
      headerFullscreenBtn.textContent = '⛶ 전체화면';
      stageFullscreenBtn.textContent = '⛶';
      resizeCanvas();
    }
  });

  // 컨테이너 크기에 맞춘 반응형 캔버스 리사이즈
  let W = stageContainer.clientWidth || window.innerWidth;
  let H = stageContainer.clientHeight || 600;
  let dpr = Math.min(window.devicePixelRatio || 1, 2);

  function resizeCanvas() {
    const rect = stageContainer.getBoundingClientRect();
    W = Math.max(300, rect.width);
    H = Math.max(420, rect.height);
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.floor(W * dpr);
    canvas.height = Math.floor(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  // 게임 상태 및 로컬 랭킹 관리
  let state = 'START';
  let score = 0;
  let bestScore = parseInt(localStorage.getItem('neon_starfighter_best') || '0', 10);
  let bestWave = parseInt(localStorage.getItem('neon_starfighter_best_wave') || '1', 10);
  let bestWpn = parseInt(localStorage.getItem('neon_starfighter_best_wpn') || '1', 10);

  function renderLeaderboard() {
    bestVal.textContent = bestScore.toLocaleString();
    myBestBadge.textContent = `MY BEST: ${bestScore.toLocaleString()}`;

    const rivals = [
      { name: 'NOVA_PRIME', wave: 14, wpn: 285, score: 1480000, isMe: false },
      { name: 'STAR_WALKER', wave: 11, wpn: 210, score: 890000, isMe: false },
      { name: 'CYBER_ACE', wave: 8, wpn: 145, score: 420000, isMe: false },
      { name: 'ORION_PILOT', wave: 5, wpn: 82, score: 155000, isMe: false }
    ];

    if (bestScore > 0) {
      rivals.push({
        name: 'YOU (COMMANDER)',
        wave: bestWave,
        wpn: bestWpn,
        score: bestScore,
        isMe: true
      });
    }

    rivals.sort((a, b) => b.score - a.score);

    leaderboardBody.innerHTML = rivals.slice(0, 5).map((r, idx) => `
      <tr class="${r.isMe ? 'bg-cyan-500/15 text-cyan-200' : 'text-slate-300'}">
        <td class="py-2.5 px-3 font-black ${idx === 0 ? 'text-amber-400' : ''}">#${idx + 1}</td>
        <td class="py-2.5 px-3 font-bold">${r.name}</td>
        <td class="py-2.5 px-3 text-cyan-400">W-${String(r.wave).padStart(2, '0')}</td>
        <td class="py-2.5 px-3 text-purple-300">LV.${r.wpn}</td>
