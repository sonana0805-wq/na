<!DOCTYPE html>
<html lang="ko" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>NEON STARFIGHTER | 아케이드 슈팅 웹 포털</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }

  body {
    margin: 0;
    padding: 0;
    background-color: #03050c;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Noto Sans KR", sans-serif;
    color: #f8fafc;
    overflow-x: hidden;
  }

  /* 게임 뷰포트 컨테이너 */
  #gameStageContainer {
    position: relative;
    width: 100%;
    height: min(78vh, 720px);
    min-height: 520px;
    background: #050712;
    overflow: hidden;
    touch-action: none;
  }

  /* 전체화면 모드 지원 */
  #gameStageContainer.is-fullscreen {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    max-width: none !important;
    border-radius: 0 !important;
    border: none !important;
    z-index: 9999 !important;
  }

  #gameCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
    touch-action: none;
  }

  /* 인게임 HUD */
  #hud {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 10px 12px 4px;
    z-index: 10;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hud-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(8, 13, 30, 0.78);
    border: 1px solid rgba(0, 245, 255, 0.28);
    border-radius: 10px;
    padding: 6px 12px;
    backdrop-filter: blur(8px);
    font-size: 12px;
    font-weight: 700;
  }

  .hud-stat {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-variant-numeric: tabular-nums;
  }

  .hud-stat .label {
    color: #7dd3fc;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.6px;
  }

  .hud-stat .val {
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
  }

  .hud-wave-tag {
    color: #00f5ff;
    font-size: 11px;
    font-weight: 900;
    padding: 2px 9px;
    border-radius: 6px;
    background: rgba(0, 245, 255, 0.14);
    border: 1px solid rgba(0, 245, 255, 0.35);
  }

  .hud-bars {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .bar-box {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(8, 13, 30, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 4px 9px;
    backdrop-filter: blur(6px);
  }

  .bar-label {
    font-size: 10px;
    font-weight: 800;
    color: #94a3b8;
    white-space: nowrap;
    min-width: 62px;
    font-variant-numeric: tabular-nums;
  }

  .bar-track {
    flex: 1;
    height: 5px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
  }

  .bar-fill-hp {
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #ff2a85, #ff7b00, #22ff88);
    border-radius: 999px;
    transition: width 0.12s linear;
  }

  .bar-fill-wpn {
    height: 100%;
    width: 1%;
    background: linear-gradient(90deg, #00f5ff, #38bdf8, #c084fc, #ffd000);
    border-radius: 999px;
    transition: width 0.15s ease;
  }

  #bossHud {
    display: none;
    background: rgba(24, 6, 18, 0.84);
    border: 1px solid rgba(255, 42, 133, 0.55);
    border-radius: 9px;
    padding: 5px 10px;
    backdrop-filter: blur(6px);
  }

  .boss-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10.5px;
    font-weight: 800;
    margin-bottom: 4px;
    color: #ff7ab8;
  }

  .boss-phase-tag {
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 9px;
    background: rgba(255, 208, 0, 0.18);
    border: 1px solid rgba(255, 208, 0, 0.45);
    color: #ffd000;
  }

  .boss-hp-track {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    overflow: hidden;
  }

  .boss-hp-fill {
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #ff0055, #ff5e00, #ffd000);
    border-radius: 999px;
    transition: width 0.08s linear;
  }

  .stage-controls {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 60;
    display: flex;
    gap: 8px;
  }

  .stage-ctrl-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid rgba(0, 245, 255, 0.35);
    background: rgba(8, 13, 30, 0.78);
    color: #00f5ff;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: all 0.15s ease;
  }

  .stage-ctrl-btn:hover {
    background: rgba(0, 245, 255, 0.2);
    transform: translateY(-1px);
  }

  #warningBanner {
    position: absolute;
    top: 96px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    pointer-events: none;
    display: none;
    flex-direction: column;
    align-items: center;
    padding: 6px 16px;
    border-radius: 10px;
    background: rgba(28, 6, 18, 0.88);
    border: 1px solid rgba(255, 42, 133, 0.75);
    animation: pulseWarn 0.35s infinite alternate;
    white-space: nowrap;
  }

  #warningBanner .warn-top {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #ffd000;
  }

  #warningBanner .warn-main {
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 1.2px;
    color: #ff2a85;
    text-shadow: 0 0 12px rgba(255, 42, 133, 0.85);
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-align: center;
    background: radial-gradient(circle at 50% 30%, rgba(16, 32, 72, 0.72), rgba(5, 7, 18, 0.92));
    backdrop-filter: blur(6px);
  }

  .overlay.hidden {
    display: none !important;
  }

  .cta-btn {
    padding: 12px 32px;
    border-radius: 999px;
    border: 1px solid rgba(0, 245, 255, 0.65);
    background: linear-gradient(135deg, #0ea5e9, #6366f1);
    color: #ffffff;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 1px;
    cursor: pointer;
    box-shadow: 0 0 22px rgba(0, 245, 255, 0.4);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .cta-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 0 28px rgba(0, 245, 255, 0.65);
  }

  @keyframes pulseWarn {
    from { opacity: 0.55; transform: translateX(-50%) scale(0.98); }
    to { opacity: 1; transform: translateX(-50%) scale(1.02); }
  }
</style>
</head>
<body class="bg-[#03050c] text-slate-100 antialiased selection:bg-cyan-500/30 selection:text-cyan-200">

